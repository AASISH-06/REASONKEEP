# REASONKEEP — Root Environment Variables Template
#
# Copy this file to `backend/.env` and fill in your actual values.
# Never commit `.env` to version control.
#
# ─────────────────────────────────────────
# Backend Core Settings
# ─────────────────────────────────────────
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────
# Hindsight Cloud Memory Layer
# Obtain credentials from https://ui.hindsight.vectorize.io
# ─────────────────────────────────────────
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BANK_ID=reasonkeep-university-demo
